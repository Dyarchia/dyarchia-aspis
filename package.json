{
    "name": "dyarchia-aspis",
    "version": "0.1.0-alpha",
    "private": true,
    "type": "module",
    "workspaces": ["packages/*", "apps/*"],
    "scripts": {
        "dev": "bun run --cwd apps/desktop tauri dev",
        "dev:web": "bun run --filter '@dyarchia/server' --filter '@dyarchia/ui' dev",
        "typecheck": "bun run --filter '*' typecheck",
        "test": "bun test packages apps/server",
        "sidecar": "bun run --cwd apps/server compile",
        "release": "bun run --cwd apps/desktop tauri build"
    },
    "devDependencies": {
        "@playwright/test": "1.64.0"
    }
}
